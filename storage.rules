rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Highlights - photos and videos uploaded by authenticated users
    match /highlights/{gameId}/{fileName} {
      // Only authenticated users can view highlights
      allow read: if request.auth != null;

      // Authenticated users can upload
      // Max file size: 50MB (reduced from 100MB)
      // Only images and videos allowed
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Compiled highlight reels - created by Cloud Functions
    match /compiled-highlights/{gameId}/{fileName} {
      // Only authenticated users can view compiled videos
      allow read: if request.auth != null;
      // No client writes - only Cloud Functions write these
    }
  }
}
