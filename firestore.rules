rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the head coach
    function isHeadCoach() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/config/headCoach) &&
        get(/databases/$(database)/documents/config/headCoach).data.email == request.auth.token.email.lower();
    }

    // Game stats - read/write by authenticated users
    match /gameStats/{gameId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Volunteers - read/write by authenticated users
    match /volunteers/{gameId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Attendance - read/write by authenticated users
    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Chat messages - read/write by authenticated users
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated();
      allow update: if false; // Messages can't be edited
    }

    // Chat read status - users can only read/write their own
    match /chatReadStatus/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // FCM tokens for push notifications - users can manage their own
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // User profiles - users can read all, write their own
    match /userProfiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Config (schedule/roster sync) - readable by authenticated, writable by functions only
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only cloud functions can write
    }

    // Highlights - photos/videos of game moments
    match /highlights/{docId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.uploadedBy == request.auth.uid;
    }

    // Viewers - invited family members who can view but not interact
    // Parents can manage viewers for their player
    match /viewers/{playerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      // Note: Frontend verifies user is a parent of this player before allowing writes
    }

    // Wrap-ups - post-game AI reports with coach notes
    match /wrapups/{gameId} {
      // Anyone authenticated can read wrap-ups
      allow read: if isAuthenticated();
      // Only head coach can update (add coach notes)
      allow update: if isHeadCoach();
      // Only cloud functions create wrap-ups
      allow create, delete: if false;
    }

    // Posts - head coach announcements with reactions and comments
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // Only head coach can create, update, delete posts
      allow create, update, delete: if isHeadCoach();

      // Comments on posts - any authenticated user can comment
      match /comments/{commentId} {
        allow read, create, delete: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      }
    }

    // Rate limits - managed by Cloud Functions only
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
