rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is coach (must be in roster.json coaches list)
    function isCoach() {
      return isAuthenticated();
      // Note: Full coach check would require storing coaches in Firestore
    }

    // Game stats - read by anyone, write by authenticated users
    match /gameStats/{gameId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Volunteers - read by anyone, write by authenticated users
    match /volunteers/{gameId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Attendance - read by anyone, write by authenticated users
    match /attendance/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Chat messages - read/write by authenticated users
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated();
      allow update: if false; // Messages can't be edited
    }

    // Chat read status - users can only read/write their own
    match /chatReadStatus/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // FCM tokens for push notifications - users can manage their own
    match /fcmTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // User profiles - users can read all, write their own
    match /userProfiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Config (schedule/roster sync) - readable by all, writable by functions only
    match /config/{docId} {
      allow read: if true;
      allow write: if false; // Only cloud functions can write
    }

    // Highlights - photos/videos of game moments
    match /highlights/{docId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.uploadedBy == request.auth.uid;
    }

    // Viewers - invited family members who can view but not interact
    // Parents can manage viewers for their player
    match /viewers/{playerId} {
      allow read: if true;
      allow write: if isAuthenticated();
      // Note: Frontend verifies user is a parent of this player before allowing writes
    }

    // Posts - coach announcements with reactions and comments
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();

      // Comments on posts
      match /comments/{commentId} {
        allow read, create, delete: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
