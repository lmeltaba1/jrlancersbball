rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user email in lowercase
    function getUserEmail() {
      return request.auth.token.email.lower();
    }

    // Helper: Check if user is the head coach
    function isHeadCoach() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/config/headCoach) &&
        get(/databases/$(database)/documents/config/headCoach).data.email == getUserEmail();
    }

    // Helper: Check if user is any coach
    function isCoach() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/config/coachEmails) &&
        getUserEmail() in get(/databases/$(database)/documents/config/coachEmails).data;
    }

    // Helper: Check if user is admin (head coach or in adminEmails)
    function isAdmin() {
      return isHeadCoach() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/config/adminEmails) &&
        getUserEmail() in get(/databases/$(database)/documents/config/adminEmails).data
      );
    }

    // Helper: Validate stat value is non-negative integer or null
    function isValidStat(val) {
      return val == null || (val is int && val >= 0);
    }

    // Helper: Validate player stats object has valid values
    function hasValidPlayerStats(stats) {
      return stats is map &&
        isValidStat(stats.get('points', null)) &&
        isValidStat(stats.get('rebounds', null)) &&
        isValidStat(stats.get('assists', null)) &&
        isValidStat(stats.get('steals', null)) &&
        isValidStat(stats.get('blocks', null)) &&
        isValidStat(stats.get('fouls', null)) &&
        isValidStat(stats.get('turnovers', null)) &&
        isValidStat(stats.get('twoPointersMade', null)) &&
        isValidStat(stats.get('twoPointersMissed', null)) &&
        isValidStat(stats.get('threePointersMade', null)) &&
        isValidStat(stats.get('threePointersMissed', null)) &&
        isValidStat(stats.get('freeThrowsMade', null)) &&
        isValidStat(stats.get('freeThrowsMissed', null));
    }

    // Game stats - read by authenticated, create/update by authenticated (scorekeeper), delete by coach
    // Note: Scorekeeper role and time window are validated by frontend
    match /gameStats/{gameId} {
      allow read: if isAuthenticated();
      // Create/update: authenticated user, validate stat values are non-negative
      allow create, update: if isAuthenticated() &&
        // Validate gamePhase if present
        (!('gamePhase' in request.resource.data) ||
          request.resource.data.gamePhase in ['pre', 'Q1', 'Q2', 'halftime', 'Q3', 'Q4', 'OT', 'final']) &&
        // Validate lancersScore and opponentScore if present
        isValidStat(request.resource.data.get('lancersScore', null)) &&
        isValidStat(request.resource.data.get('opponentScore', null));
      // Only coaches can delete
      allow delete: if isCoach();
    }

    // Volunteers - read by authenticated, write by authenticated (parents/coaches sign up)
    match /volunteers/{gameId} {
      allow read: if isAuthenticated();
      // Write: authenticated users, validate structure
      allow write: if isAuthenticated() &&
        // Must have valid structure for scorekeeper/tableWorker if present
        (!('scorekeeper' in request.resource.data) ||
          (request.resource.data.scorekeeper is map &&
           request.resource.data.scorekeeper.keys().hasAll(['email', 'name']))) &&
        (!('tableWorker' in request.resource.data) ||
          (request.resource.data.tableWorker is map &&
           request.resource.data.tableWorker.keys().hasAll(['email', 'name'])));
    }

    // Attendance - read by authenticated, write by authenticated
    match /attendance/{docId} {
      allow read: if isAuthenticated();
      // Write: authenticated users, validate required fields
      // attending can be boolean (true/false) or legacy string ('yes'/'no'/'maybe')
      allow write: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['gameId', 'playerId', 'attending']) &&
        (request.resource.data.attending is bool ||
         request.resource.data.attending in ['yes', 'no', 'maybe']) &&
        request.resource.data.gameId is int;
    }

    // Chat messages - read/create by authenticated, author can delete own
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      // Create: must set senderUid to own UID
      allow create: if isAuthenticated()
        && request.resource.data.senderUid == request.auth.uid;
      // Delete: only own messages or coaches
      allow delete: if isAuthenticated()
        && (resource.data.senderUid == request.auth.uid || isCoach());
      // Messages can't be edited
      allow update: if false;
    }

    // Chat read status - users can only read/write their own
    match /chatReadStatus/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // FCM tokens - users can only manage their own tokens
    match /fcmTokens/{tokenId} {
      // Read: only own tokens or coaches (for sending notifications)
      allow read: if isAuthenticated();
      // Write: must set uid field to own UID
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      // Update: only own tokens
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      // Delete: only own tokens
      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
    }

    // User profiles - users can read all, write their own
    match /userProfiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Config (schedule/roster sync) - readable by authenticated, writable by functions only
    match /config/{docId} {
      allow read: if isAuthenticated();
      // Simulation config: only admins/coaches can modify (for time testing)
      allow write: if docId == 'simulation' && isAdmin();
      // Allow head coach to manage hidden plays
      allow write: if docId == 'hiddenPlays' && isHeadCoach();
      // Other config docs only writable by cloud functions (roster, schedule, headCoach, etc.)
    }

    // Highlights - photos/videos of game moments
    match /highlights/{docId} {
      allow read: if isAuthenticated();
      // Create: must set uploadedBy to own UID, validate required fields
      allow create: if isAuthenticated() &&
        request.resource.data.uploadedBy == request.auth.uid &&
        // Must have either downloadUrl (real upload) or url (simulated)
        ('downloadUrl' in request.resource.data || 'url' in request.resource.data) &&
        // Must have gameId and playerId
        'gameId' in request.resource.data &&
        'playerId' in request.resource.data &&
        request.resource.data.gameId is int &&
        request.resource.data.playerId is int;
      // Update: only uploader can update
      allow update: if isAuthenticated() &&
        resource.data.uploadedBy == request.auth.uid;
      // Delete: uploader or coaches can delete
      allow delete: if isAuthenticated() &&
        (resource.data.uploadedBy == request.auth.uid || isCoach());
    }

    // Parent-player mapping for viewer management validation
    // Generated by syncConfig from roster data
    match /parentPlayers/{email} {
      allow read: if isAuthenticated();
      // Only cloud functions can write (via syncConfig)
      allow write: if false;
    }

    // Helper: Check if user is parent of the given player
    function isParentOf(playerId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/parentPlayers/$(getUserEmail())) &&
        int(playerId) in get(/databases/$(database)/documents/parentPlayers/$(getUserEmail())).data.playerIds;
    }

    // Viewers - invited family members who can view but not interact
    // Only parents can manage viewers for their own kids, coaches can manage any
    match /viewers/{playerId} {
      allow read: if isAuthenticated();
      // Write: coaches OR parent of this specific player
      allow write: if isAuthenticated() &&
        // Validate viewers array structure if present
        (!('viewers' in request.resource.data) ||
          request.resource.data.viewers is list) &&
        // Validate removedEmails is array if present
        (!('removedEmails' in request.resource.data) ||
          request.resource.data.removedEmails is list) &&
        // Must be coach OR parent of this player
        (isCoach() || isParentOf(playerId));
    }

    // Wrap-ups - post-game AI reports with coach notes
    match /wrapups/{gameId} {
      // Anyone authenticated can read wrap-ups
      allow read: if isAuthenticated();
      // Only head coach can update (add coach notes)
      // Only allow updating coachNotes field
      allow update: if isHeadCoach()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coachNotes', 'updatedAt']);
      // Allow head coach to create/delete (for seeding), otherwise only cloud functions
      allow create, delete: if isHeadCoach();
    }

    // Posts - head coach announcements with reactions and comments
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // Only head coach can create, update, delete posts
      allow create, update, delete: if isHeadCoach();

      // Comments on posts - any authenticated user can comment
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        // Create: must set authorUid to own UID
        allow create: if isAuthenticated()
          && request.resource.data.authorUid == request.auth.uid;
        // Update: only author
        allow update: if isAuthenticated()
          && resource.data.authorUid == request.auth.uid;
        // Delete: author or head coach
        allow delete: if isAuthenticated()
          && (resource.data.authorUid == request.auth.uid || isHeadCoach());
      }
    }

    // Rate limits - managed by Cloud Functions only
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Pending notifications queue - managed by Cloud Functions only
    match /pendingNotifications/{docId} {
      allow read, write: if false;
    }

    // Emulation audit logs - admins can create, head coach can read
    match /emulationLogs/{logId} {
      // Only head coach can read logs for auditing
      allow read: if isHeadCoach();
      // Authenticated users can create (but validation ensures only admins use emulation)
      allow create: if isAuthenticated()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == getUserEmail();
      // Logs cannot be updated or deleted (immutable audit trail)
      allow update, delete: if false;
    }

    // Team-wide notifications - all users can read, only functions write
    match /teamNotifications/{notificationId} {
      allow read: if isAuthenticated();
      // Only cloud functions can create/update/delete
      allow write: if false;
    }

    // Per-user notification status (read/dismissed tracking)
    match /notificationStatus/{uid} {
      // Users can only read/write their own status
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // User notifications - targeted/private notifications (only user can read)
    match /userNotifications/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow update: if isAuthenticated() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAuthenticated() && request.auth.uid == uid;
        allow create: if false;
      }
    }

    // Custom plays - coaches can create/edit, all authenticated users can read
    match /customPlays/{playId} {
      allow read: if isAuthenticated();
      // Create: only coaches, must set createdBy to own email
      allow create: if isCoach()
        && request.resource.data.createdBy == getUserEmail();
      // Update: only coaches
      allow update: if isCoach();
      // Delete: only coaches
      allow delete: if isCoach();
    }
  }
}
